# ===================================
# EAS Build Ignore File
# NOTE: .easignore REPLACES .gitignore for EAS uploads.
# Must include everything from .gitignore plus build-specific exclusions.
# ===================================

# Native builds (generated by EAS — do NOT upload)
# android/ is NOT committed → EAS prebuilds it from app.json.
android/

# ios/ IS committed (hand-managed watchOS target). It MUST be uploaded so EAS
# uses the bare workflow; otherwise EAS prebuilds a fresh, watch-less project.
# .easignore replaces .gitignore, so mirror .gitignore's ios/ subpath excludes:
ios/Pods/
ios/build/
ios/DerivedData/
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
ios/.xcode.env.local

# Dependencies (EAS installs from lockfile)
node_modules/
jspm_packages/
web_modules/

# Git
.git/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# EAS
.eas/

# Build outputs
build/

# Tests
**/__tests__/
**/*.test.ts
**/*.test.tsx
**/__snapshots__/
coverage/
*.lcov
.nyc_output/
*.hprof
jest.setup.js
jest.config.js

# Storybook
**/*.stories.tsx
**/*.stories.ts
.storybook/
storybook.tsx

# Documentation
docs/
*.md
!README.md

# Development tools
# Exclude scripts/ EXCEPT the build-time secret injector, which the
# eas-build-post-install hook runs on the builder.
scripts/*
!scripts/inject-maps-key.js
.vscode/
.idea/
*.iml

# Claude / AI
.claude/
.superpowers/

# Environment variables
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# TypeScript
*.tsbuildinfo

# Caches
.cache/
.parcel-cache/
.npm/
.eslintcache
.stylelintcache

# macOS
.DS_Store
*.pem

# Signing keys and certificates
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
google-service-account.json

# Supabase local
supabase/.branches/
supabase/.temp/

# Yarn
.yarn-integrity
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Misc
*.tgz
.node_repl_history
.grunt/
.lock-wscript
.tern-port
templates/
LICENSE
regions.geojson
