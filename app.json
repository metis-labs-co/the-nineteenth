{
  "expo": {
    "name": "The Nineteenth",
    "slug": "the-nineteenth",
    "scheme": "thenineteenth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1f2937"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "golf.thenineteenth",
      "buildNumber": "13",
      "appleTeamId": "9D3K8VW249",
      "associatedDomains": [
        "applinks:thenineteenth.golf",
        "applinks:www.thenineteenth.golf"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Allow The Nineteenth to take photos for your profile picture.",
        "NSPhotoLibraryUsageDescription": "Allow The Nineteenth to access your photos for your profile picture.",
        "NSPhotoLibraryAddUsageDescription": "Allow The Nineteenth to save photos to your library.",
        "NSLocationWhenInUseUsageDescription": "Allow The Nineteenth to find nearby golf courses.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1f2937"
      },
      "package": "golf.thenineteenth",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "thenineteenth.golf",
              "pathPrefix": "/app/auth"
            },
            {
              "scheme": "https",
              "host": "www.thenineteenth.golf",
              "pathPrefix": "/app/auth"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2563eb"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow The Nineteenth to find nearby golf courses.",
          "locationWhenInUsePermission": "Allow The Nineteenth to find nearby golf courses."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow The Nineteenth to access your photos for your profile picture.",
          "cameraPermission": "Allow The Nineteenth to take photos for your profile picture."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow The Nineteenth to take photos for your profile picture."
        }
      ],
      "expo-sqlite",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "9168db7d-0580-4f85-be5a-5edc7fb673e7"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9168db7d-0580-4f85-be5a-5edc7fb673e7"
    },
    "owner": "samcodexdev"
  }
}
