{
  "expo": {
    "name": "The Nineteenth",
    "slug": "the-nineteenth",
    "scheme": "thenineteenth",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "1.13.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#2f3428"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.the.nineteenth.golf",
      "buildNumber": "17",
      "usesAppleSignIn": true,
      "appleTeamId": "TMB3988D5Z",
      "associatedDomains": [
        "applinks:thenineteenth.golf",
        "applinks:www.thenineteenth.golf",
        "webcredentials:thenineteenth.golf"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Allow The Nineteenth to take photos for your profile and rounds.",
        "NSPhotoLibraryUsageDescription": "Allow The Nineteenth to access your photos for your profile picture.",
        "NSPhotoLibraryAddUsageDescription": "Allow The Nineteenth to save photos to your library.",
        "NSFaceIDUsageDescription": "Allow The Nineteenth to unlock the app with Face ID for quick and secure access.",
        "NSLocationWhenInUseUsageDescription": "Allow The Nineteenth to find nearby golf courses.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#003913"
      },
      "package": "com.the.nineteenth.golf",
      "versionCode": 50,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "thenineteenth.golf",
              "pathPrefix": "/app/auth"
            },
            {
              "scheme": "https",
              "host": "www.thenineteenth.golf",
              "pathPrefix": "/app/auth"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563eb"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow The Nineteenth to find nearby golf courses.",
          "locationWhenInUsePermission": "Allow The Nineteenth to find nearby golf courses."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow The Nineteenth to access your photos for your profile picture.",
          "cameraPermission": "Allow The Nineteenth to take photos for your profile and rounds."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow The Nineteenth to take photos for your profile and rounds."
        }
      ],
      "expo-apple-authentication",
      "expo-sqlite",
      "expo-font",
      "expo-local-authentication",
      "expo-secure-store",
      "expo-web-browser",
      "expo-localization",
      "expo-video",
      "./plugins/withWearOs"
    ],
    "runtimeVersion": "1.12.7",
    "owner": "sam-metislabs",
    "extra": {
      "eas": {
        "projectId": "12e43c05-e41f-4f10-bbd7-65789519c1a9"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/12e43c05-e41f-4f10-bbd7-65789519c1a9"
    }
  }
}
