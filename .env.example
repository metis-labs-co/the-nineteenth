# API Configuration
API_BASE_URL=http://localhost:3000/api

# Australia Golf Course Finder API (Zyla Labs) - Phase 1
EXPO_PUBLIC_AUSTRALIA_GOLF_API_KEY=your_zyla_api_key_here
EXPO_PUBLIC_AUSTRALIA_GOLF_API_URL=https://zylalabs.com/api/3176

# GolfAPI.io - Phase 2 (42,000+ courses with hole-by-hole data)
EXPO_PUBLIC_GOLFAPI_IO_URL=https://api.golfapi.io/v1
EXPO_PUBLIC_GOLFAPI_IO_KEY=your_golfapi_key_here

# Environment
NODE_ENV=development

# Feature Flags
ENABLE_OFFLINE_MODE=true
ENABLE_BACKGROUND_SYNC=true

# RevenueCat In-App Purchases
# Get your API key from https://app.revenuecat.com → Project Settings → API Keys
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_api_key_here
# Webhook secret for signature verification (from RevenueCat dashboard)
REVENUECAT_WEBHOOK_SECRET=whsec_your_webhook_secret_here
