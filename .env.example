# Supabase Configuration (Get from https://supabase.com → Project Settings → API Keys)
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# API Configuration
API_BASE_URL=http://localhost:3000/api

# GolfAPI.io - Golf Course Data API (42,000+ courses with hole-by-hole data)
# Documentation: https://golfapi.io/docs/
# Auth: Bearer token in Authorization header
EXPO_PUBLIC_GOLFAPI_IO_URL=https://www.golfapi.io/api/v2.3
EXPO_PUBLIC_GOLFAPI_IO_KEY=your_golfapi_key_here

# Environment
NODE_ENV=development

# Feature Flags
ENABLE_OFFLINE_MODE=true
ENABLE_BACKGROUND_SYNC=true

# RevenueCat In-App Purchases
# Get your API key from https://app.revenuecat.com → Project Settings → API Keys
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_api_key_here
# Webhook secret for signature verification (from RevenueCat dashboard)
REVENUECAT_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Google Maps SDK keys (native maps for iOS/Android) — separate keys per platform
# because GCP Application Restrictions accept only one app type per key.
#
# iOS key: restrict to iOS apps with bundle com.the.nineteenth.golf
# Android key: restrict to Android apps with package com.the.nineteenth.golf
#   + SHA-1 fingerprints from `eas credentials` (upload key) and Play Console (app signing key)
# Both keys: API restrictions = Maps SDK for iOS + Maps SDK for Android only.
#
# Read by app.config.js at build time — do NOT prefix with EXPO_PUBLIC_
# (would ship the key in the JS bundle).
# For EAS builds, set as sensitive env vars:
#   eas env:create --environment production --visibility sensitive --name GOOGLE_MAPS_API_KEY_IOS --value <key>
#   eas env:create --environment production --visibility sensitive --name GOOGLE_MAPS_API_KEY_ANDROID --value <key>
GOOGLE_MAPS_API_KEY_IOS=your_ios_maps_key_here
GOOGLE_MAPS_API_KEY_ANDROID=your_android_maps_key_here
