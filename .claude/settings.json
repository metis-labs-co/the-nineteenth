{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/scoring-edit-nudge.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "pnpm type-check" },
          {
            "type": "command",
            "command": "pnpm test --testPathPattern='(golden|services/scoring|utils/(scoring|dailyHandicap|teamHandicap|competitionPoints|matchMargin))' --silent"
          }
        ]
      }
    ]
  }
}
